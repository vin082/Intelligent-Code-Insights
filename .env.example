# OpenAI Configuration (Required)
OPENAI_API_KEY=sk-your-openai-api-key-here

# LangSmith Configuration (Optional - for observability)
# Sign up at: https://smith.langchain.com
# Get API key from: https://smith.langchain.com/settings

# Enable LangSmith tracing
LANGCHAIN_TRACING_V2=true

# Your LangSmith API key
LANGCHAIN_API_KEY=lsv2_pt_your-langsmith-api-key-here

# Project name (organizes traces in LangSmith dashboard)
LANGCHAIN_PROJECT=IntelligentCodeInsights

# LangSmith endpoint (default - usually no need to change)
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Environment tag (helps separate dev/staging/prod traces)
ENVIRONMENT=development
